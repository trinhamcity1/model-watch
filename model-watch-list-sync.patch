diff --git a/scripts/check_compliance_lists.py b/scripts/check_compliance_lists.py
new file mode 100644
index 0000000..7f73459
--- /dev/null
+++ b/scripts/check_compliance_lists.py
@@ -0,0 +1,24 @@
+"""Fails if script 1's built-in blocked-developer list differs from bench/compliance.py (the single source).
+Script 1 must keep its own copy so it still works when copied alone to another machine.
+Run: python scripts/check_compliance_lists.py  (the weekly scout workflow runs it too)."""
+import ast, pathlib, sys
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+
+def prohibited_orgs(path):
+    """Read the PROHIBITED_ORGS literal without running the file (script 1 would otherwise load the repo list)."""
+    for node in ast.parse(path.read_text()).body:
+        if isinstance(node, ast.Assign) and any(getattr(t, "id", None) == "PROHIBITED_ORGS" for t in node.targets):
+            return ast.literal_eval(node.value)
+    sys.exit(f"No PROHIBITED_ORGS in {path}")
+
+repo = prohibited_orgs(ROOT / "bench" / "compliance.py")
+script1 = prohibited_orgs(ROOT / "scripts" / "build_bundle.py")
+if repo == script1:
+    print(f"OK: script 1 and bench/compliance.py block the same {sum(map(len, repo.values()))} organisations")
+    sys.exit(0)
+for dev in sorted(set(repo) | set(script1)):
+    a, b = set(repo.get(dev, [])), set(script1.get(dev, []))
+    if a != b:
+        print(f"{dev}: only in bench/compliance.py {sorted(a - b)}; only in scripts/build_bundle.py {sorted(b - a)}")
+sys.exit("The two blocked lists differ: copy bench/compliance.py's PROHIBITED_ORGS into scripts/build_bundle.py")
